# shellcheck shell=bash
# shellcheck disable=SC2034

declare thread_if
declare otbr_forward_ingress_chain
declare otbr_forward_egress_chain
declare otbr_forward_nat64_chain
declare otbr_fw_mark
thread_if="wpan0"
otbr_forward_ingress_chain="OTBR_FORWARD_INGRESS"
otbr_forward_egress_chain="OTBR_FORWARD_EGRESS"
otbr_forward_nat64_chain="OTBR_FORWARD_NAT64"
otbr_fw_mark="0x1001"

# Map the configured otbr_log_level to the numeric level expected by the
# otbr-agent/otbr-web -d flag. Echoes the numeric level on success, returns
# non-zero on an unknown level (callers own the user-facing error message).
otbr_log_level_to_int() {
    local level
    level=$(bashio::string.lower "$(bashio::config 'advanced.otbr_log_level')")
    case "${level}" in
        debug)     echo "7" ;;
        info)      echo "6" ;;
        notice)    echo "5" ;;
        warning)   echo "4" ;;
        error)     echo "3" ;;
        critical)  echo "2" ;;
        alert)     echo "1" ;;
        emergency) echo "0" ;;
        *)         return 1 ;;
    esac
}

# ot-ctl exits 0 on a CLI error or a dropped session. As with otctl, output
# without a final "Done" is a failure; unlike otctl, new optional commands are
# bounded and never fatal. Prints only the reply before "Done" (e.g. panid).
otbr_cli() {
    local output
    if ! output=$(timeout --kill-after=1 5 ot-ctl "$@" 2>&1); then
        bashio::log.warning "OpenThread command failed: $* (${output})" >&2
        return 1
    fi
    if [[ "${output//[[:space:]]/}" != *Done ]]; then
        bashio::log.warning "OpenThread rejected command: $* (${output})" >&2
        return 1
    fi
    output="${output%Done*}"
    if [[ -n "${output//[[:space:]]/}" ]]; then
        printf '%s\n' "${output}"
    fi
}

# Only native Thread controls need startup ordering, not app options/defaults.
otbr_has_thread_settings() {
    [[ "$(bashio::jq "$(bashio::app.config)" '
        [.advanced | .tx_power, .leader_weight, .router_eligible, .trel,
            .omr_mode, .omr_prefix, .omr_preference, .route_preference,
            .rio_preference, .srp_address_mode, .srp_anycast_sequence_number]
        | any(. != null)
    ')" == "true" ]]
}

# Pass one optional setting to its native CLI command, including numeric zero.
otbr_apply_setting() {
    local option="advanced.$1"
    shift
    if bashio::config.has_value "${option}"; then
        otbr_cli "$@" "$(bashio::config "${option}")" || true
    fi
}
